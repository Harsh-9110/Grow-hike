# Copy to .env to customize. docker compose up also works with development defaults.
ENVIRONMENT=development
DEMO_MODE=true
DEMO_EMAIL=demo@growhike.dev
DEMO_PASSWORD=GrowHike-Demo-2026!
POSTGRES_USER=grow
POSTGRES_PASSWORD=grow_dev_only
POSTGRES_DB=grow
DATABASE_URL=postgresql+psycopg://grow:grow_dev_only@db:5432/grow
REDIS_URL=redis://redis:6379/0
JWT_SECRET=local-only-change-before-deployment-32-bytes-minimum
# Generate: docker compose exec backend python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
ENCRYPTION_KEY=
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
QUOTE_TTL=60
STALE_SECONDS=604800
# These Yahoo numbers are self-imposed budgets, not advertised provider limits.
YAHOO_PER_MINUTE=30
YAHOO_PER_DAY=2000
ALPHA_VANTAGE_KEY=
TWELVE_DATA_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
KITE_API_KEY=
KITE_API_SECRET=
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
INSTALL_ML=false
